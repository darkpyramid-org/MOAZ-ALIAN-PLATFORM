# Analyzer style for the whole api-server.
root = true

[*.cs]
indent_style = space
indent_size = 4
charset = utf-8
insert_final_newline = true

# Namespaces and usings: file-scoped namespaces, system usings first, no wildcards.
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# Explicit types where the var would hide intent; var where the right side says it all.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# This is one deliberate deviation from the recommended ruleset.
#
# CA1848 (LoggerMessage delegates) pays for itself in request-hot loops. Here logging happens
# on cold paths — JWKS refresh once an hour, exceptions at most — so the delegate ceremony
# would add indirection with no measurable gain.
dotnet_diagnostic.CA1848.severity = none

# The domain throws domain-language messages; CA1032 would demand exception ctors we never use.
dotnet_diagnostic.CA1032.severity = none

# Throw helpers like Guard.Required take string names by design; CA1054/CA1056 would force
# System.Uri values through the validation path before it is even known the string is a URL.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1056.severity = none
dotnet_diagnostic.CA1055.severity = none

# ---------------------------------------------------------------------------
# EF Core-generated files (migrations + model snapshot). Machine output that is
# regenerated on every `dotnet ef migrations add`; editing it to satisfy an
# analyser would be lost the next run. The human-written configurations that
# produce it are still fully gated.
# ---------------------------------------------------------------------------
[**/Migrations/**.cs]
generated_code = true
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1812.severity = none
dotnet_diagnostic.CA1848.severity = none
dotnet_diagnostic.CA2007.severity = none
