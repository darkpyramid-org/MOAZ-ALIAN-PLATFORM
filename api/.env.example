# ---------------------------------------------------------------------------
# MOAZ ALIAN API — environment template. Copy to .env and fill in.
# All values mirror the ASP.NET appsettings keys they replace.
# ---------------------------------------------------------------------------

# PostgreSQL connection. The `schema` parameter pins the search_path to the
# library schema — the API's tables live there, never in public.
DATABASE_URL=postgresql://moaz:moaz_dev@localhost:5434/moaz_alian?schema=library

# JWT signing secret. At least 32 characters (256 bits of HMAC-SHA256 key).
# Replaces Auth:JwtSecret. MUST be changed per environment.
AUTH_JWT_SECRET=

# JWT issuer/audience. Issuer defaults to http://localhost:5199 (the ASP.NET
# default) when unset; audience defaults to "authenticated".
# AUTH_ISSUER=https://api.example.com
# AUTH_AUDIENCE=authenticated

# Admin allowlist — the ONLY path to the admin role (mirrors Auth:AdminEmails).
# Accepts a JSON array, or indexed keys AUTH_ADMIN_EMAILS_0=…
# (comma-separated values are deliberately NOT supported — same as ASP.NET).
# AUTH_ADMIN_EMAILS=["admin@example.com"]

# Role names (mirrors Auth:AdminRole / Auth:EditorRole / Auth:ServiceRole).
# AUTH_ADMIN_ROLE=admin
# AUTH_EDITOR_ROLE=editor
# AUTH_SERVICE_ROLE=service_role

# Where OAuth callbacks redirect the browser (Auth:FrontendUrl).
FRONTEND_URL=http://localhost:8080

# CORS. ALLOWED_ORIGINS is a JSON array; when empty and ALLOW_VERCEL_ORIGINS
# is true, any *.vercel.app origin is accepted. In development, any
# localhost/127.0.0.1 origin is accepted when neither is configured.
# CORS_ALLOWED_ORIGINS=["https://your-frontend.example"]
CORS_ALLOW_VERCEL_ORIGINS=false

# Server port (the ASP.NET app listened on 5199).
PORT=5199

# Public read-through cache (ContentCache section).
CONTENT_CACHE_ENABLED=true
# CONTENT_CACHE_QUERY_TTL_MS=45000
# CONTENT_CACHE_ITEM_TTL_MS=120000
# CONTENT_CACHE_COUNTS_TTL_MS=300000

# Rate limits (requests per minute): global per user-or-IP, editorial for writes.
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_EDITORIAL_PER_MINUTE=30

# OpenAPI docs: enabled by default in development.
# SWAGGER_ENABLED=true

# OAuth providers (Auth:OAuth:google / Auth:OAuth:facebook). A provider is
# enabled only when CLIENT_ID, CLIENT_SECRET and REDIRECT_URI are all set.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=
# OAUTH_GOOGLE_SCOPE="openid email profile"
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=
