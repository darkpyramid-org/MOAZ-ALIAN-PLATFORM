# ---------------------------------------------------------------------------
# MOAZ ALIAN API — environment template. Copy to .env and fill in.
# All values are per-environment; never commit a filled-in .env.
# ---------------------------------------------------------------------------

# PostgreSQL connection. In production this MUST point at a publicly-reachable
# Postgres (Neon / Supabase / RDS) — Vercel functions cannot reach localhost.
# The `schema` parameter pins the search_path to the library schema.
DATABASE_URL=postgresql://moaz:moaz_dev@localhost:5434/moaz_alian?schema=library

# JWT signing secret. At least 32 characters (256 bits of HMAC-SHA256 key).
# Generate one per environment; do not reuse the dev default.
AUTH_JWT_SECRET=

# JWT issuer/audience. Issuer defaults to http://localhost:5199 when unset;
# set to your public API origin in production if you verify the issuer.
# AUTH_ISSUER=https://api.example.come
# AUTH_AUDIENCE=authenticated

# Admin allowlist — the ONLY path to the admin role.
# Accepts a JSON array, or indexed keys AUTH_ADMIN_EMAILS_0=…
# AUTH_ADMIN_EMAILS=["admin@example.com"]

# Role names.
# AUTH_ADMIN_ROLE=admin
# AUTH_EDITOR_ROLE=editor
# AUTH_SERVICE_ROLE=service_role

# Frontend URL used for OAuth callbacks and email links.
FRONTEND_URL=http://localhost:8080

# Transactional password reset email (Resend).
# Configure both values in deployed environments before enabling password recovery.
# RESEND_API_KEY=re_...
# EMAIL_FROM=no-reply@example.com

# CORS. ALLOWED_ORIGINS is a JSON array; when empty and ALLOW_VERCEL_ORIGINS
# is true, any *.vercel.app origin is accepted. In development, localhost
# origins are accepted when neither is configured.
# CORS_ALLOWED_ORIGINS=["https://your-frontend.example"]
CORS_ALLOW_VERCEL_ORIGINS=false

# Server port (defaults to 5199; Vercel functions ignore this).
PORT=5199

# Public read-through cache.
CONTENT_CACHE_ENABLED=true
# CONTENT_CACHE_QUERY_TTL_MS=45000
# CONTENT_CACHE_ITEM_TTL_MS=120000
# CONTENT_CACHE_COUNTS_TTL_MS=300000

# Rate limits (requests per minute).
RATE_LIMIT_GLOBAL_PER_MINUTE=300
RATE_LIMIT_EDITORIAL_PER_MINUTE=30

# OpenAPI docs: enabled by default in development.
# SWAGGER_ENABLED=true

# OAuth providers. A provider is enabled only when CLIENT_ID, CLIENT_SECRET
# and REDIRECT_URI are all set.
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# OAUTH_GOOGLE_REDIRECT_URI=
# OAUTH_GOOGLE_SCOPE="openid email profile"
# OAUTH_FACEBOOK_CLIENT_ID=
# OAUTH_FACEBOOK_CLIENT_SECRET=
# OAUTH_FACEBOOK_REDIRECT_URI=
