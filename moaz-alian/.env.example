# Client-exposed (safe for browser bundle — public keys only)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Server-only (never prefix with VITE_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# AI chat gateway (server)
LOVABLE_API_KEY=your_lovable_api_key

# Optional: Drizzle migrations / ops
LOVABLE_DB_MIGRATION_URL=postgresql://user:password@host:5432/postgres

# Optional: cron auth rotation
LOVABLE_CRON_SECRET=
LOVABLE_CRON_SECRET_PREVIOUS=
